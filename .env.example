# 🌐 Environment Configuration Template
# ==========================================
# Copy this file to .env.local and fill in your specific values
# DO NOT commit .env.local to version control

# 🔐 AZURE ENTRA ID AUTHENTICATION
# ==========================================
# Set to false to use Azure Entra ID authentication
VITE_USE_LOCAL_AUTH=false

# Your Azure App Registration details (replace with actual values)
VITE_AZURE_CLIENT_ID=your-azure-client-id
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id

# Redirect URIs for authentication (update for production)
VITE_REDIRECT_URI=http://localhost:5173
VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# 🗄️ DATABASE CONFIGURATION
# ==========================================
# Azure Cosmos DB connection
VITE_COSMOS_DB_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
VITE_COSMOS_DB_NAME=cato-dashboard

# For development only - use Managed Identity in production
VITE_COSMOS_DB_KEY=your-cosmos-key-for-dev-only

# 🌐 MULTI-ENVIRONMENT API SUPPORT (Optional)
# ==========================================
# IL2 (Commercial Azure) API endpoints

# 🔧 AZURE FUNCTIONS INTEGRATION
# ==========================================
# Azure Functions endpoint for automated data sync
VITE_AZURE_FUNCTIONS_ENDPOINT=https://your-function-app-name.azurewebsites.net
VITE_AZURE_FUNCTIONS_KEY=your-azure-function-key

# Azure Functions API paths
VITE_AZURE_FUNCTIONS_MANUAL_SYNC_PATH=/api/ManualDataSync
VITE_AZURE_FUNCTIONS_TIMER_STATUS_PATH=/api/DataSyncTimer

# Enable/disable Azure Functions integration
VITE_ENABLE_AZURE_FUNCTIONS=true

# Application Configuration
VITE_APP_TITLE=cATO - Continuous Authorization to Operate
VITE_APP_VERSION=1.0.0

# API Configuration
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Feature Flags
VITE_ENABLE_REAL_TIME_SYNC=true
VITE_ENABLE_AUTO_REFRESH=true

# Monitoring and Logging
VITE_LOG_LEVEL=info
VITE_ENABLE_TELEMETRY=true
VITE_IL2_API_ENDPOINT=https://your-il2-app.azurewebsites.net/api
VITE_IL2_API_SCOPE=api://your-il2-client-id/access_as_user

# IL5 (Azure Government) API endpoints  
VITE_IL5_API_ENDPOINT=https://your-il5-app.azurewebsites.us/api
VITE_IL5_API_SCOPE=api://your-il5-client-id/access_as_user

# 🔐 AZURE KEY VAULT (Optional - for advanced configuration)
# ==========================================
AZURE_KEY_VAULT_ENDPOINT=https://your-key-vault.vault.azure.net/

# 📊 MONITORING (Optional)
# ==========================================
APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string

# 🔧 DEVELOPMENT SETTINGS
# ==========================================
# For local development only
NODE_ENV=development
VITE_API_BASE_URL=http://localhost:3000
