{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "cosmosdb_nosql",
    "connection-string": "",
    "options": {
      "database": "cato-dashboard",
      "schema": "staticwebapp.database.schema.gql"
    }
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api"
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true
    },
    "host": {
      "cors": {
        "origins": ["*"],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "StaticWebApps"
      }
    }
  },
  "entities": {
    "NistControl": {
      "source": "nist-controls",
      "permissions": [
        {
          "role": "authenticated",
          "actions": ["read", "create", "update"]
        },
        {
          "role": "anonymous",
          "actions": ["read"]
        }
      ]
    },
    "ZtaActivity": {
      "source": "zta-activities", 
      "permissions": [
        {
          "role": "authenticated",
          "actions": ["read", "create", "update"]
        },
        {
          "role": "anonymous",
          "actions": ["read"]
        }
      ]
    },
    "PoamItem": {
      "source": "poam-items",
      "permissions": [
        {
          "role": "authenticated",
          "actions": ["read", "create", "update", "delete"]
        }
      ]
    },
    "Vulnerability": {
      "source": "vulnerabilities",
      "permissions": [
        {
          "role": "authenticated",
          "actions": ["read", "create", "update", "delete"]
        }
      ]
    },
    "ControlHistory": {
      "source": "control-history",
      "permissions": [
        {
          "role": "authenticated",
          "actions": ["read", "create"]
        }
      ]
    }
  }
}
