# Cosmos DB Configuration for ZTA Data Import
COSMOS_CONNECTION_STRING=AccountEndpoint=https://your-account.documents.azure.com:443/;AccountKey=your-primary-key==;
COSMOS_DB_NAME=cato-dashboard
COSMOS_CONTAINER_ACTIVITIES=zta-activities
COSMOS_CONTAINER_CAPABILITIES=zta-capabilities

# Optional: Alternative individual settings (if not using connection string)
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-primary-key
